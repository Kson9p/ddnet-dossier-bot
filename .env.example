# Скопируйте в .env и замените фиктивные значения.
# Формат: КЛЮЧ=значение. Слева всегда BOT_TOKEN и OWNER_ID, справа — значения.
# Не используйте @username бота или свой Telegram ID в качестве ключа.
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample
OWNER_ID=123456789
DATABASE_PATH=data/bot.db

# Необязательные настройки
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_MESSAGES=30
RATE_LIMIT_MIN_INTERVAL_SECONDS=1.0
RATE_LIMIT_MAX_TRACKED_USERS=10000
RATE_LIMIT_WARNING_COOLDOWN_SECONDS=30

MEDIA_GROUP_DELAY_SECONDS=0.8
MEDIA_GROUP_MAX_BUFFERS=500
MEDIA_GROUP_MAX_ITEMS=10

HISTORY_RETENTION_DAYS=30
HISTORY_PAGE_SIZE=15
ADMIN_PAGE_SIZE=8

TELEGRAM_MAX_RETRIES=2
FLOODWAIT_MAX_SECONDS=60
MAINTENANCE_INTERVAL_SECONDS=21600
